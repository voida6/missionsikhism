---
import { getCollection } from 'astro:content';
import { jsonScript } from '../json-script';

/**
 * Glossary hover-cards: any link to /glossary/<term> inside the page's main
 * content shows a small card with the term, its Gurmukhi, transliteration, and
 * definition on hover or keyboard focus. Desktop enhancement only — on touch
 * devices the link simply navigates to the glossary as before, which shows the
 * full entry rather than a summary of it. Either way the link is marked as a
 * defined term by `main a[href^="/glossary/"]` in global.css, so the
 * affordance does not depend on having a pointer.
 */
const glossary = await getCollection('glossary');
const terms = Object.fromEntries(
  glossary.map((g) => [
    g.id,
    {
      term: g.data.term,
      gurmukhi: g.data.gurmukhi ?? '',
      translit: g.data.transliteration ?? '',
      def: g.data.definition,
    },
  ])
);
---

<script type="application/json" id="glossary-data" set:html={jsonScript(terms)} />
<div id="gloss-pop" class="gloss-pop" role="tooltip" hidden></div>

<script is:inline>
  (function () {
    // Hover-capable pointers only; touch users navigate to the glossary page.
    if (!window.matchMedia('(hover: hover)').matches) return;
    var dataEl = document.getElementById('glossary-data');
    var pop = document.getElementById('gloss-pop');
    if (!dataEl || !pop) return;
    var terms;
    try { terms = JSON.parse(dataEl.textContent); } catch (e) { return; }

    var hideTimer = null;
    var removeTimer = null;
    var lastHidden = 0;
    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }
    function show(link, id) {
      var t = terms[id];
      if (!t) return;
      clearTimeout(hideTimer);
      pop.innerHTML =
        '<span class="gloss-term">' + esc(t.term) + '</span>' +
        (t.gurmukhi ? '<span class="gloss-gurmukhi">' + esc(t.gurmukhi) + '</span>' : '') +
        (t.translit ? '<span class="gloss-translit">' + esc(t.translit) + '</span>' : '') +
        '<p class="gloss-def">' + esc(t.def) + '</p>' +
        '<a class="gloss-link" href="/glossary/' + esc(id) + '">Glossary entry →</a>';
      pop.hidden = false;
      var r = link.getBoundingClientRect();
      var pw = pop.offsetWidth;
      var left = Math.max(8, Math.min(r.left + r.width / 2 - pw / 2, window.innerWidth - pw - 8));
      var top = r.bottom + 8;
      var above = top + pop.offsetHeight > window.innerHeight - 8;
      if (above) top = r.top - pop.offsetHeight - 8;
      pop.style.left = left + 'px';
      pop.style.top = top + 'px';

      // Grow from the edge facing the word being defined, so the card never
      // scales away from its own subject.
      pop.style.setProperty('--gloss-origin', above ? 'bottom' : 'top');

      // Once one card has been shown, the next few open instantly. Moving
      // along a line of linked terms should feel like one card following the
      // cursor rather than a new one being built at each word.
      if (lastHidden && Date.now() - lastHidden < 400) pop.setAttribute('data-instant', '');
      else pop.removeAttribute('data-instant');

      // Force a style flush so the browser has the closed state on record
      // before the open state lands — without this the two are batched into
      // one recalculation and there is nothing to transition between.
      void pop.offsetWidth;
      pop.setAttribute('data-open', '');
    }
    function hide() {
      pop.removeAttribute('data-open');
      lastHidden = Date.now();
      // Keep it in the layout until the fade finishes, or it disappears
      // instantly and the transition is never seen.
      clearTimeout(removeTimer);
      removeTimer = setTimeout(function () {
        if (!pop.hasAttribute('data-open')) pop.hidden = true;
      }, 160);
    }
    function scheduleHide() {
      hideTimer = setTimeout(hide, 150);
    }
    pop.addEventListener('mouseenter', function () { clearTimeout(hideTimer); });
    pop.addEventListener('mouseleave', scheduleHide);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') hide();
    });
    // On scroll the card would be left behind by the word it belongs to, so it
    // goes immediately rather than fading — the connection is already broken.
    window.addEventListener('scroll', function () {
      clearTimeout(hideTimer);
      pop.removeAttribute('data-open');
      pop.hidden = true;
      lastHidden = Date.now();
    }, { passive: true });

    var links = document.querySelectorAll('main a[href^="/glossary/"]');
    Array.prototype.forEach.call(links, function (link) {
      var id = link.getAttribute('href').split('/').filter(Boolean).pop();
      if (!id || !terms[id]) return;
      link.addEventListener('mouseenter', function () { show(link, id); });
      link.addEventListener('mouseleave', scheduleHide);
      link.addEventListener('focus', function () { show(link, id); });
      link.addEventListener('blur', scheduleHide);
    });
  })();
</script>
