---
/**
 * Renders the citations for a piece of content. Because the `sources` field is
 * required by the schema, this component always has something to show — the
 * "every fact sourced" promise made visible on the page.
 */
interface Source {
  title: string;
  author?: string;
  publisher?: string;
  year?: number;
  url?: string;
  page?: string;
  note?: string;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

<aside class="sources">
  <h4>Sources</h4>
  <p class="sources-note">Numbers in the text link to the work that supports the claim.</p>
  <ol>
    {
      sources.map((s, i) => (
        // id="src-N" is the landing point for the {{N}} markers in the prose.
        <li id={`src-${i + 1}`}>
          {s.author && <span>{s.author}. </span>}
          {s.url ? (
            <a href={s.url} rel="noopener noreferrer" target="_blank">
              <cite>{s.title}</cite>
            </a>
          ) : (
            <cite>{s.title}</cite>
          )}
          {s.publisher && <span>. {s.publisher}</span>}
          {s.year && <span> ({s.year})</span>}
          <span>.</span>
          {/* The locator — which page, ang, sakhi or var actually carries the
              claim. Set on its own line so it reads as a pointer rather than
              as part of the title. */}
          {s.page && <span class="src-locator">{s.page}</span>}
          {s.note && <span class="src-note">{s.note}</span>}
        </li>
      ))
    }
  </ol>
</aside>
