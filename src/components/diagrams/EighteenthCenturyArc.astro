---
/**
 * The eighteenth century as a single shape: catastrophe and expansion running
 * at the same time, not in sequence.
 *
 * Drawn because the narrative order of the entries — Banda executed, decades
 * of persecution, two massacres, then sovereignty — implies recovery *after*
 * suffering. The dates say otherwise: the community took Sirhind two years
 * after losing perhaps a third of its people, and Lahore three years after.
 * A timeline shows that in a way prose has to keep asserting.
 */
import Diagram from '../Diagram.astro';
---

<Diagram
  title="Diagram: a timeline of the Sikh eighteenth century from 1708 to 1799, showing the two ghallugharas against the sequence of Sikh territorial gains"
  caption="1708–1799. Losses above the line, gains below. The point is the overlap: Sirhind falls two years after the Vadda Ghallughara and Lahore three years after — the recovery is not sequential to the catastrophe, it runs through it. Casualty figures for 1762 are heavily disputed; see the entry."
>
  <svg viewBox="0 0 700 320" xmlns="http://www.w3.org/2000/svg" role="img">
    <!-- Losses, above the axis -->
    <text class="d-title" x="16" y="20">Blows to the community</text>

    <g>
      <line class="d-line" x1="60" y1="34" x2="60" y2="168" stroke-width="1.2" stroke-dasharray="2 3" />
      <circle class="d-fill-ink" cx="60" cy="168" r="4" />
      <text class="d-label" x="60" y="52" text-anchor="middle">1716</text>
      <text class="d-note" x="60" y="68" text-anchor="middle">Banda Singh</text>
      <text class="d-note" x="60" y="81" text-anchor="middle">executed</text>
    </g>

    <g>
      <line class="d-line" x1="238" y1="34" x2="238" y2="168" stroke-width="1.2" stroke-dasharray="2 3" />
      <circle class="d-fill-ink" cx="238" cy="168" r="4" />
      <text class="d-label" x="238" y="52" text-anchor="middle">1746</text>
      <text class="d-note" x="238" y="68" text-anchor="middle">Chhota</text>
      <text class="d-note" x="238" y="81" text-anchor="middle">Ghallughara</text>
    </g>

    <g>
      <line class="d-line-accent" x1="331" y1="34" x2="331" y2="168" stroke-width="2" />
      <circle class="d-fill-accent" cx="331" cy="168" r="5.5" />
      <text class="d-title" x="331" y="52" text-anchor="middle">1762</text>
      <text class="d-sub" x="331" y="69" text-anchor="middle">Vadda Ghallughara</text>
      <text class="d-note" x="331" y="84" text-anchor="middle">the Great Massacre</text>
    </g>

    <g>
      <line class="d-line" x1="367" y1="100" x2="367" y2="168" stroke-width="1.2" stroke-dasharray="2 3" />
      <circle class="d-fill-ink" cx="367" cy="168" r="3.5" />
      <text class="d-note" x="380" y="112">1762 · Harmandir Sahib destroyed</text>
    </g>

    <!-- The axis -->
    <line class="d-rule" x1="40" y1="168" x2="670" y2="168" stroke-width="1.5" />
    <text class="d-year" x="40" y="188">1708</text>
    <text class="d-year" x="670" y="188" text-anchor="end">1799</text>

    <!-- Gains, below the axis -->
    <g>
      <line class="d-line-accent" x1="47" y1="168" x2="47" y2="212" stroke-width="1.2" stroke-dasharray="2 3" />
      <circle class="d-fill-accent" cx="47" cy="168" r="4" />
      <text class="d-label" x="47" y="228" text-anchor="middle">1710</text>
      <text class="d-note" x="47" y="244" text-anchor="middle">Sirhind taken</text>
      <text class="d-note" x="47" y="257" text-anchor="middle">first Sikh rule</text>
    </g>

    <g>
      <line class="d-line-accent" x1="250" y1="168" x2="250" y2="212" stroke-width="1.2" stroke-dasharray="2 3" />
      <circle class="d-fill-accent" cx="250" cy="168" r="4" />
      <text class="d-label" x="250" y="228" text-anchor="middle">1748</text>
      <text class="d-note" x="250" y="244" text-anchor="middle">Dal Khalsa formed</text>
      <text class="d-note" x="250" y="257" text-anchor="middle">bands become misls</text>
    </g>

    <g>
      <line class="d-line-accent" x1="345" y1="168" x2="345" y2="212" stroke-width="1.2" stroke-dasharray="2 3" />
      <circle class="d-fill-accent" cx="345" cy="168" r="4" />
      <text class="d-label" x="345" y="228" text-anchor="middle">1764</text>
      <text class="d-note" x="345" y="244" text-anchor="middle">Sirhind falls</text>
      <text class="d-note" x="345" y="257" text-anchor="middle">to the Khalsa</text>
    </g>

    <g>
      <line class="d-line-accent" x1="452" y1="168" x2="452" y2="212" stroke-width="1.2" stroke-dasharray="2 3" />
      <circle class="d-fill-accent" cx="452" cy="168" r="4" />
      <text class="d-label" x="452" y="228" text-anchor="middle">1765</text>
      <text class="d-note" x="452" y="244" text-anchor="middle">Lahore taken</text>
      <text class="d-note" x="452" y="257" text-anchor="middle">coin struck</text>
    </g>

    <g>
      <line class="d-line-accent" x1="640" y1="168" x2="640" y2="212" stroke-width="1.2" stroke-dasharray="2 3" />
      <circle class="d-fill-accent" cx="640" cy="168" r="4" />
      <text class="d-label" x="640" y="228" text-anchor="middle">1799</text>
      <text class="d-note" x="640" y="244" text-anchor="middle">Ranjit Singh</text>
      <text class="d-note" x="640" y="257" text-anchor="middle">takes Lahore</text>
    </g>

    <text class="d-title" x="16" y="290">Territory and institutions gained</text>

    <!-- The two-year gap, called out -->
    <path class="d-line-accent" d="M331 300 L345 300" stroke-width="0" />
    <text class="d-note" x="350" y="308" text-anchor="middle">
      Two years separate the Great Massacre from the capture of Sirhind
    </text>
  </svg>
</Diagram>
