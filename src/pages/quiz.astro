---
import BaseLayout from '../layouts/BaseLayout.astro';
import Quiz from '../components/Quiz.astro';
import { allQuestions } from '../quiz-content';

// The bank is generated at build time from the collections, so it ships as
// data and the page needs no network call and no backend. See src/quiz.ts for
// why generation is deterministic and why distractors come from the same pool
// as the answer.
const questions = await allQuestions();
---

<BaseLayout
  title="Quiz — Mission Sikhism"
  description="Test what you know about Sikh history — eras, places, years, the ten Gurus, and the words of the faith. Every question comes from a sourced entry on this site."
>
  <section class="section">
    <div class="container quiz-page">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a> › <span aria-current="page">Quiz</span>
      </nav>
      <span class="kicker">Test yourself</span>
      <h1>Quiz</h1>
      <p class="lede">
        {questions.length} questions, every one drawn from a sourced entry on this
        site. Get one wrong and you can read the entry it came from. Nothing is
        recorded anywhere but your own browser.
      </p>

      <Quiz questions={questions} showTiers round={10} />
    </div>
  </section>
</BaseLayout>
